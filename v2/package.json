{
  "name": "seeds-hues-v2",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/build-sw.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run verify:spa",
    "verify:spa": "npm --prefix ../app ci && npm --prefix ../app run verify",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:import:local": "tsx scripts/import-catalog.ts",
    "db:publish:local": "tsx scripts/publish-catalog.ts",
    "db:setup:local": "npm run db:migrate:local && npm run db:import:local && npm run db:publish:local",
    "api-key:create": "tsx scripts/create-api-key.ts",
    "rollup": "tsx scripts/rollup.ts",
    "farm-summaries": "tsx scripts/farm-summaries.ts",
    "zip-zones": "tsx scripts/gen-zip-zones.ts",
    "icons": "tsx scripts/gen-icons.ts",
    "images:data": "tsx scripts/gen-images-data.ts",
    "cf:build": "node scripts/build-sw.mjs && opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "acceptance": "tsx scripts/acceptance.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.17",
    "drizzle-orm": "0.45.4",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261116.1",
    "@eslint/eslintrc": "3.3.7",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "wrangler": "4.162.0"
  }
}
