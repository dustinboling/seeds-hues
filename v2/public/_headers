# Cloudflare Workers Static Assets headers (next.config headers() do not apply to files served
# directly from the assets binding).
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Service-Worker-Allowed: /
  X-Content-Type-Options: nosniff

/icons/*
  Cache-Control: public, max-age=604800
  X-Content-Type-Options: nosniff

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Own-work variety illustrations (media.r2_key = /artwork/<file>.webp). Never overwrite a file in
# place: a replacement gets a new filename and the media row's r2_key is updated.
/artwork/*
  Cache-Control: public, max-age=31536000, immutable

# Theme illustrations, grain tile and divider (theme delta). Filenames are not content-hashed, so a
# week, like /icons/, rather than immutable.
/theme/*
  Cache-Control: public, max-age=604800
  X-Content-Type-Options: nosniff

# The Hues Floral Park wordmark (branding delta). The filename is not content-hashed, so a week,
# like /icons/.
/brand/*
  Cache-Control: public, max-age=604800
  X-Content-Type-Options: nosniff

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
