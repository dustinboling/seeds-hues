{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:4173/",
        "http://localhost:4173/variety",
        "http://localhost:4173/seller",
        "http://localhost:4173/crop",
        "http://localhost:4173/search"
      ],
      "numberOfRuns": 3,
      "startServerCommand": "SEEDS_API_BASE=stub:parity npm run serve",
      "startServerReadyPattern": "listening on http",
      "startServerReadyTimeout": 60000
    },
    "assert": {
      "assertions": {
        "largest-contentful-paint": ["error", { "maxNumericValue": 6000 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["error", { "maxNumericValue": 200 }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 153600 }],
        "errors-in-console": ["error", { "maxNumericValue": 0 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
